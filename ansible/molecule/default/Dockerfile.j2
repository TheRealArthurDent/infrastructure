# Approximates a fresh Raspberry Pi OS Lite (trixie): python, sudo, cron, procps (/etc/sysctl.d), gpg, openssl, ssh client,
# iproute2 (Ansible's network facts, e.g. default_ipv4, need the ip command).
FROM {{ item.image }}

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 sudo cron procps gnupg openssl openssh-client ca-certificates iproute2 \
 && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash smarthome \
 && echo 'smarthome ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/bootstrap \
 && chmod 0440 /etc/sudoers.d/bootstrap
