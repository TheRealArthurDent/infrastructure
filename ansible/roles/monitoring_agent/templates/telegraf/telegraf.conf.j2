# Managed by Ansible (monitoring_agent role, #39). Telegraf reloads this file when it changes.

[agent]
  hostname = "{{ inventory_hostname }}"
  omit_hostname = false
  interval = "{{ monitoring_agent_interval }}"
  flush_interval = "{{ monitoring_agent_interval }}"
  round_interval = true
  collection_jitter = "5s"
  # Keeps up to this many metrics while VictoriaMetrics is unreachable
  metric_buffer_limit = 10000

# The Compose secrets in /run/secrets, referenced as @{docker_secrets:<name>}
[[secretstores.docker]]
  id = "docker_secrets"

# nginx on the central host passes /write on to VictoriaMetrics, which takes the InfluxDB line protocol there and has no
# databases to create.
[[outputs.influxdb]]
  urls = ["{{ monitoring_agent_url }}"]
  skip_database_creation = true
  timeout = "10s"
  username = "{{ monitoring_agent_user }}"
  password = "@{docker_secrets:metrics_writer_password}"
  tls_ca = "{{ monitoring_agent_root_ca }}"

# The host, read through /hostfs (HOST_PROC, HOST_SYS, HOST_MOUNT_PREFIX)
[[inputs.cpu]]
  percpu = false
  totalcpu = true
  collect_cpu_time = false

[[inputs.mem]]

[[inputs.swap]]

[[inputs.system]]

# Every mount, the backup SSD too, without pseudo and container file systems
[[inputs.disk]]
  ignore_fs = ["tmpfs", "devtmpfs", "devfs", "overlay", "aufs", "squashfs", "nsfs", "iso9660", "ramfs", "efivarfs"]

[[inputs.diskio]]
  devices = ["sd*", "nvme*", "mmcblk*"]
  skip_serial_number = true

[[inputs.net]]
  interfaces = ["eth*", "wlan*", "end*", "enx*"]
  ignore_protocol_stats = true

[[inputs.temp]]

# Lifetime of the host's nginx certificate and of the root CA (x509_cert_expiry, in seconds)
[[inputs.x509_cert]]
  sources = {{ monitoring_agent_certificates | to_json }}

# The containers. Compose and the images put a dozen labels on each one; as tags they would multiply the series, so
# none is kept (an empty include list would keep them all).
[[inputs.docker]]
  # Read-only, through the proxy (docker_socket_proxy)
  endpoint = "tcp://docker-socket-proxy:2375"
  gather_services = false
  docker_label_exclude = ["*"]
  perdevice_include = []
  total_include = ["cpu", "blkio", "network"]
  timeout = "10s"

# The backup metrics of resticprofile: Prometheus text files (backup.prom, offsite_*.prom, ...). Read into one
# measurement with the metric names as fields; the processor below takes their prefix off, so VictoriaMetrics stores
# them under the names resticprofile wrote (resticprofile_<field>). A host without resticprofile has no such files.
[[inputs.file]]
  files = ["{{ monitoring_agent_resticprofile_metrics }}/*.prom"]
  data_format = "prometheus"
  prometheus_metric_version = 2
  name_override = "resticprofile"
  # Build info of resticprofile and restic: labels only, no value worth a series
  fieldexclude = ["resticprofile_build_info", "restic_build_info"]

[[processors.strings]]
  namepass = ["resticprofile"]
  [[processors.strings.trim_prefix]]
    field_key = "*"
    prefix = "resticprofile_"
