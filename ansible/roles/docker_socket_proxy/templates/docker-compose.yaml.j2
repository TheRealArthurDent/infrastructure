services:
  # The Docker API for the containers that only read it (healthmonitor, telegraf-agent), at
  # tcp://docker-socket-proxy:2375 in the network docker-api. HAProxy in front of the socket: GET on the container
  # list, the containers' details and stats, and the engine info; every other path and every POST get a 403.
  docker-socket-proxy:
    hostname: docker-socket-proxy
    container_name: docker-socket-proxy
    # Pinned by tag and digest, updated by hand (renovate.json)
    image: linuxserver/socket-proxy:3.4.7-r0-ls103@sha256:e5d819de59b343c01b2fe7adc7fad3c7a60e5dba08e45f1ac317352bc08599b5
    environment:
      CONTAINERS: '1'
      INFO: '1'
      POST: '0'
      # The network docker-api has no IPv6; without it HAProxy would also try to listen on [::]
      DISABLE_IPV6: '1'
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    read_only: true
    tmpfs:
      - /run
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: "{{ docker_socket_proxy_memory_limit }}"
    restart: unless-stopped
    networks:
      - docker-api

networks:
  # Only the proxy and its clients; no internet, no nginx
  docker-api:
    name: docker-api
    internal: true
