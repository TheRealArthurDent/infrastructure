# yaml-language-server: $schema=https://creativeprojects.github.io/resticprofile/jsonschema/config.json

version: "1"

global:
  scheduler: crond
  # restic refreshes the lock of a running command every 5 minutes; 2h leaves a margin for the slow Pi
  restic-stale-lock-age: 2h
  restic-lock-retry-after: 1m

default:
  password-file: /run/secrets/restic_passphrase
  # Remove restic locks older than restic-stale-lock-age (left by an interrupted run) and retry (raspberry#250)
  force-inactive-lock: true
  # No overlapping resticprofile runs inside the container
  lock: /tmp/resticprofile-default.lock
  repository: {{ resticprofile_repository }}
  initialize: true
{% if resticprofile_backup_mount | length > 0 %}
  # Profile level on purpose: resticprofile runs these before "initialize" (section-level run-before runs after it),
  # so a missing SSD can't get a repository created on the system disk. The SSD's marker exists only while it is
  # mounted; without it /backup is the empty directory of the system disk. Every command of the profile is guarded.
  run-before:
    - >-
      [ -f /backup/{{ resticprofile_backup_marker | basename }} ]
      || { echo "/backup/{{ resticprofile_backup_marker | basename }} is missing: the backup SSD isn't mounted"; exit 1; }
{% endif %}
  prometheus-save-to-file: /metrics/backup.prom
  backup:
    source: '/source/'
    exclude-caches: true
    exclude-file: '/etc/resticprofile/excludes'
    exclude-if-present: DO_NOT_BACKUP
    one-file-system: false
    schedule: '*-*-* 03:00:00'
    schedule-permission: system
    schedule-priority: background
    # Wait for a live lock (e.g. a manual run) instead of failing at once
    schedule-lock-wait: 30m
    check-before: true
    run-before:
      - rm -f /metrics/backup.prom
    run-after:
      # Runs after backup and retention succeeded. Survives a failed run (backup.prom is deleted by
      # run-before), so an alert can fire on its age (raspberry#250). The retention section has no run-after
      # (raspberry#233).
      - >-
        echo "resticprofile_backup_last_success_timestamp_seconds{profile=\"default\"} $(date +%s)"
        > /metrics/backup_last_success.prom.tmp
        && mv /metrics/backup_last_success.prom.tmp /metrics/backup_last_success.prom
    extended-status: true
  retention:
    after-backup: true
{% for key, value in resticprofile_retention.items() %}
    {{ key }}: {{ value }}
{% endfor %}
    prune: true
{% for source in resticprofile_offsite_sources %}

# Offsite copy of {{ source }}'s repository (#60): restic copy, then the retention on the copy, then the success metric
offsite-copy-{{ source }}:
  password-file: /run/secrets/restic_passphrase
  repository: local:/backup/restic/{{ source }}
  # The copies run one after the other
  lock: /tmp/resticprofile-offsite-copy.lock
{% if resticprofile_backup_mount | length > 0 %}
  # Before the copy initializes the offsite repository: without the SSD there's nothing to copy
  run-before:
    - >-
      [ -f /backup/{{ resticprofile_backup_marker | basename }} ]
      || { echo "/backup/{{ resticprofile_backup_marker | basename }} is missing: the backup SSD isn't mounted"; exit 1; }
{% endif %}
  copy:
    repository: sftp:{{ resticprofile_offsite_alias }}:{{ resticprofile_offsite_path }}/{{ source }}
    password-file: /run/secrets/restic_offsite_passphrase
    initialize: true
    # Same chunker parameters as the source, so the copy deduplicates and the daily upload stays small
    initialize-copy-chunker-params: true
    schedule: '{{ resticprofile_offsite_schedules[source] | default(resticprofile_offsite_schedule) }}'
    schedule-permission: system
    schedule-priority: background
    schedule-lock-wait: 2h
    # For the duration in offsite-metrics.sh
    run-before:
      - date +%s > /tmp/offsite-copy-{{ source }}.start
    run-after:
      - resticprofile --name offsite-{{ source }} forget
      - >-
        echo "resticprofile_offsite_last_success_timestamp_seconds{source=\"{{ source }}\"} $(date +%s)"
        > /metrics/offsite_{{ source }}_last_success.prom.tmp
        && mv /metrics/offsite_{{ source }}_last_success.prom.tmp /metrics/offsite_{{ source }}_last_success.prom
      - >-
        sh /etc/resticprofile/offsite-metrics.sh {{ source }}
        sftp:{{ resticprofile_offsite_alias }}:{{ resticprofile_offsite_path }}/{{ source }}
        "$(cat /tmp/offsite-copy-{{ source }}.start)"

# The offsite repository of {{ source }}: its retention runs after each copy, its check once a month
offsite-{{ source }}:
  password-file: /run/secrets/restic_offsite_passphrase
  repository: sftp:{{ resticprofile_offsite_alias }}:{{ resticprofile_offsite_path }}/{{ source }}
  forget:
{% for key, value in resticprofile_retention.items() %}
    {{ key }}: {{ value }}
{% endfor %}
    prune: true
  check:
    read-data-subset: '{{ resticprofile_offsite_check_subset }}'
    schedule: '{{ resticprofile_offsite_check_schedule }}'
    schedule-permission: system
    schedule-priority: background
    run-after:
      - >-
        echo "resticprofile_offsite_check_last_success_timestamp_seconds{source=\"{{ source }}\"} $(date +%s)"
        > /metrics/offsite_{{ source }}_check.prom.tmp
        && mv /metrics/offsite_{{ source }}_check.prom.tmp /metrics/offsite_{{ source }}_check.prom
{% endfor %}
