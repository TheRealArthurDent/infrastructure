{% if resticprofile_offsite_enabled | bool %}
# The offsite target (#60). ssh takes the first value it finds, so this block comes before the global options.
Host {{ resticprofile_offsite_alias }}
  HostName {{ resticprofile_offsite_host }}
  User {{ resticprofile_offsite_user }}
  Port {{ resticprofile_offsite_port }}
  IdentityFile /root/.ssh/id_offsite
  IdentitiesOnly yes
{% if resticprofile_repository_is_sftp | bool %}

Host *
{% endif %}
{% endif %}
{% if resticprofile_repository_is_sftp | bool %}
IdentityFile /root/.ssh/id_ed25519
Port {{ dungeon_ssh_port }}
{% endif %}
