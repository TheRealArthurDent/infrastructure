services:
  # Monitoring
  healthmonitor:
    hostname: healthmonitor
    container_name: healthmonitor
    image: ghcr.io/rafhaanshah/container-mon:v1.1.1
    env_file:
      - /etc/docker/infrastructure/.healthmonitor.env
    environment:
      - CONTAINERMON_CHECK_STOPPED=false
      # container-mon does not negotiate the API version. 1.44 is the oldest version Docker 29+ accepts
      # and still within the range of Debian's docker.io 26.x. Drop it once all hosts run docker-ce 28.4+.
      - DOCKER_API_VERSION=1.44
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    restart: unless-stopped
    networks:
      - siz
      - outbound  # internet
    dns:
      - 172.30.1.153
