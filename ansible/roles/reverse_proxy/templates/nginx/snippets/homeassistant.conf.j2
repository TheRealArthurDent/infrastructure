# Home Assistant from smart-home: plain HTTP on port 8123 in the network siz, it publishes no port.
# Its configuration.yaml trusts X-Forwarded-For from this proxy only.
location / {
    resolver 127.0.0.11;
    set $homeassistant homeassistant:8123;
    proxy_pass http://$homeassistant;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    # Websockets: the frontend talks to Home Assistant over one
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
}
